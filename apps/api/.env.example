# Badminque API Environment Configuration (Copy to .env for local use; set in Koyeb dashboard)
DATABASE_URL=postgresql://user:password@ep-your-project.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
ENVIRONMENT=production
API_PREFIX=/api/v1
CORS_ORIGINS=https://badminque.vercel.app,http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
